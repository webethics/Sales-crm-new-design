# Copy to .env.local and fill in. Never commit real values.

# "live" = use the existing sales-crm backend. Anything else (or unset) = browser-only demo data.
NEXT_PUBLIC_API_MODE=live

# The Supabase project the sales-crm backend uses (the SAME project, so its session cookie works for both apps).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Origin of a running sales-crm backend (development or staging, not production), e.g. http://localhost:3000
API_PROXY_TARGET=

# Optional: shown in the upload dialog, the backend enforces the real limit.
NEXT_PUBLIC_EMAIL_MARKETING_MAX_MB=10
